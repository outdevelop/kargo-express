# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
PORT=4173
# Пароль для входа в админ-панель (/admin/)
ADMIN_PASSWORD=
# За nginx/https поставьте 1, чтобы cookie были Secure и IP брался из заголовков
TRUST_PROXY=
# Вход клиентов по звонку: mock — код показывается на экране (только для разработки), flashcall — боевой режим
FLASHCALL_MODE=mock
FLASHCALL_API_KEY=
# ГЛОНАСС: mock — демо-автовозы, real — сервер мониторинга
GLONASS_MODE=mock
GLONASS_URL=
GLONASS_LOGIN=
GLONASS_PASSWORD=
